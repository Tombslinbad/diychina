# ChatGPT / OpenAI API Configuration
# Required for OpenAI API calls. Configure this via the Settings menu.
OPENAI_API_KEY="your-openai-api-key"

# GEMINI_API_KEY: Required for Gemini AI API calls (fallback).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Paystack Configuration
# VITE_ prefixed keys are exposed to the React frontend
VITE_PAYSTACK_PUBLIC_KEY="pk_test_your_public_key_here"
PAYSTACK_SECRET_KEY="sk_test_your_secret_key_here"

# Resend Email API Integration (Recommended)
# Create a free API key at https://resend.com
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM="VerifiedUni <onboarding@resend.dev>" # Or "VerifiedUni <support@verifieduni.com>" once verified

# SMTP Email System Configuration (Alternative)
# If provided, the portal can also send real emails via standard SMTP server.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_SENDER="VerifiedUni <support@verifieduni.com>"

