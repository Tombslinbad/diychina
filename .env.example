# ChatGPT / OpenAI API Configuration
# Required for OpenAI API calls. Configure this via the Settings menu.
OPENAI_API_KEY="your-openai-api-key"

# GEMINI_API_KEY: Required for Gemini AI API calls (fallback).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Paystack Configuration
# VITE_ prefixed keys are exposed to the React frontend
VITE_PAYSTACK_PUBLIC_KEY="pk_test_your_public_key_here"
PAYSTACK_SECRET_KEY="sk_test_your_secret_key_here"

# SMTP Email System Configuration
# If provided, the portal will send real emails to users upon payment and for secure OTP sign-in.
# If not provided, it logs the professional templates in the server console for testing.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_SENDER="Admissions DIY Nigeria <admissions-diy@example.com>"

