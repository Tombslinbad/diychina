{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Premium user admissions portal account",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "premium": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "paymentReference": { "type": "string" }
      },
      "required": ["uid", "email", "premium", "createdAt"]
    },
    "Transaction": {
      "title": "Payment Transaction Ledger",
      "description": "Settled Paystack transactions and admin waivers",
      "type": "object",
      "properties": {
        "reference": { "type": "string" },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string" },
        "channel": { "type": "string" },
        "paidAt": { "type": "string" },
        "verifiedAt": { "type": "string" }
      },
      "required": ["reference", "email", "amount", "status"]
    },
    "CSCAGlobalAttempt": {
      "title": "CSCA CBT Global Attempt Record",
      "description": "Aggregated exam attempts for cohort analytics",
      "type": "object",
      "properties": {
        "attemptId": { "type": "string" },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "totalScore": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "elapsedSeconds": { "type": "number" },
        "submittedAt": { "type": "string" }
      },
      "required": ["attemptId", "email", "totalScore", "percentage"]
    },
    "AdminBroadcast": {
      "title": "Admin Broadcast Event Log",
      "description": "Log of email announcements dispatched to candidates",
      "type": "object",
      "properties": {
        "broadcastId": { "type": "string" },
        "subject": { "type": "string" },
        "audience": { "type": "string" },
        "dispatchedCount": { "type": "number" },
        "totalTargeted": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["broadcastId", "subject", "audience", "createdAt"]
    },
    "University": {
      "title": "Chinese University Detail",
      "description": "University records for CSC scholarship matching",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "agencyCode": { "type": "string" },
        "cscTypeA": { "type": "boolean" },
        "cscTypeB": { "type": "boolean" },
        "provincial": { "type": "boolean" },
        "silkRoad": { "type": "boolean" },
        "tracks": { "type": "array" },
        "stipendMasters": { "type": "number" },
        "stipendPhD": { "type": "number" },
        "city": { "type": "string" },
        "ranking": { "type": "number" }
      },
      "required": ["name", "agencyCode"]
    },
    "CSCAMockQuestion": {
      "title": "CSCA Mock CBT Question",
      "description": "Timed practice exam questions for China Scholastic Competency Assessment",
      "type": "object",
      "properties": {
        "questionId": { "type": "string" },
        "subject": { "type": "string", "enum": ["math", "physics", "chemistry", "professional_chinese"] },
        "medium": { "type": "string", "enum": ["english", "chinese"] },
        "questionText": { "type": "string" },
        "options": { "type": "array" },
        "correctOption": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "explanation": { "type": "string" }
      },
      "required": ["questionId", "subject", "questionText", "options", "correctOption"]
    },
    "LanguageInstitute": {
      "title": "Business Language Training School",
      "description": "Short-term Mandarin training centers in major trading hubs bypass diplomatic hoops",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tuitionRmb": { "type": "number", "description": "Tuition cost in RMB" },
        "location": { "type": "string", "description": "Trading hub city (Guangzhou, Yiwu, Shanghai)" },
        "startDates": { "type": "array" },
        "applicationLink": { "type": "string" }
      },
      "required": ["id", "name", "tuitionRmb"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles who registered / paid for the China Admissions portal"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial ledger transactions verified via Paystack and Admin desk"
    },
    "/csca_global_attempts/{attemptId}": {
      "schema": "CSCAGlobalAttempt",
      "description": "Global log of CSCA mock test performance"
    },
    "/admin_broadcasts/{broadcastId}": {
      "schema": "AdminBroadcast",
      "description": "Records of official consular announcements dispatched"
    },
    "/universities/{universityId}": {
      "schema": "University",
      "description": "Curated database of premier Chinese universities and stipend matrices"
    },
    "/csca_mock_questions/{questionId}": {
      "schema": "CSCAMockQuestion",
      "description": "China Scholastic Competency Assessment practice questions"
    },
    "/language_institutes/{instituteId}": {
      "schema": "LanguageInstitute",
      "description": "Commercial trader Mandarin language school listings and fees"
    }
  }
}
