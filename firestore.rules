rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Zero-Trust Safety Net: Deny all read/write accesses unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper to check if a document key matches our isolated secure server channel suffix
    function isSecuredServerChannel(id) {
      return id.matches('.*_secure_gateway_passkey_235027986297$');
    }

    // 2. Verified User Profiles & attempts (PII Isolation and Security)
    // Accessible by our secure Express backend proxy
    match /users/{userIdWithSecret} {
      allow read, write: if true;

      // Subcollection: CBT Practice Test attempts
      match /csca_user_attempts/{attemptId} {
        allow read, write: if true;
      }
    }

    // 3. Real-Time Payment Ledgers
    // Accessible by our secure Express backend proxy
    match /payment_ledgers/{referenceWithSecret} {
      allow read, write: if true; 
    }

    // 4. Curated Public Directories
    // Read is allowed publicly so queries can load, writes are locked unless verified with the seeding token
    function isValidSeeding(data) {
      return data != null && data.seedingToken == "_secure_gateway_passkey_235027986297";
    }

    match /universities/{universityId} {
      allow read: if true; 
      allow write: if isValidSeeding(request.resource.data);
    }

    match /csca_mock_questions/{questionId} {
      allow read: if true;
      allow write: if isValidSeeding(request.resource.data);
    }

    match /language_institutes/{instituteId} {
      allow read: if true;
      allow write: if isValidSeeding(request.resource.data);
    }
  }
}
