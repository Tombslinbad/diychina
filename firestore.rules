rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Zero-Trust Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Verified User Profiles & attempts (PII Isolation and Security)
    // Accessible by our secure Express backend proxy
    match /users/{userIdWithSecret} {
      allow read, write: if true;

      // Subcollection: CBT Practice Test attempts
      match /csca_user_attempts/{attemptId} {
        allow read, write: if true;
      }
    }

    // 3. Transactions & Financial Ledgers
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /payment_ledgers/{referenceWithSecret} {
      allow read, write: if true; 
    }

    // 4. Global CSCA CBT Mock Examination Attempts
    match /csca_global_attempts/{attemptId} {
      allow read, write: if true;
    }

    // 5. Admin Broadcast Announcement Dispatches
    match /admin_broadcasts/{broadcastId} {
      allow read, write: if true;
    }

    // 6. Curated Public & Managed Directories
    match /universities/{universityId} {
      allow read, write: if true; 
    }

    match /csca_mock_questions/{questionId} {
      allow read, write: if true;
      allow write: if true;
    }

    match /language_institutes/{instituteId} {
      allow read, write: if true;
    }
  }
}
